{
  "languages": {
    "JavaScript": {
      "formatter": {
        "external": {
          "command": "bunx",
          "arguments": ["oxfmt", "--stdin-filepath", "{buffer_path}"]
        }
      }
    },
    "TypeScript": {
      "formatter": {
        "external": {
          "command": "bunx",
          "arguments": ["oxfmt", "--stdin-filepath", "{buffer_path}"]
        }
      },
      "language_servers": [
        "typescript-ls",
        "!vtsls",
        "!typescript-language-server",
        "..."
      ]
    }
  },
  "lsp": {
    "typescript-ls": {
      "settings": {
        "package_version": "7.0.2"
      }
    }
  }
}
